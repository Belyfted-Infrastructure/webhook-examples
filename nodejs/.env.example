# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Webhook signature verification ----
# Path to the provider's RSA PUBLIC key (PEM). The private key must never be
# present on this server.
WEBHOOK_PUBLIC_KEY_PATH=./keys/public.pem
WEBHOOK_SIGNATURE_HEADER=DigitalSignature
WEBHOOK_MAX_BODY_SIZE=100kb

# ---- Webhook event schema (CONFIRM against Belyfted documentation) ----
WEBHOOK_EVENT_TYPE_FIELD=type
WEBHOOK_EVENT_ID_FIELD=id

# ---- Idempotency ----
WEBHOOK_IDEMPOTENCY_ENABLED=true
WEBHOOK_IDEMPOTENCY_TTL_MS=86400000

# ---- Replay protection ----
# Body-only signatures do NOT provide replay protection. Enable this only if
# the provider confirms it sends a trustworthy signed timestamp.
WEBHOOK_REPLAY_PROTECTION_ENABLED=false
WEBHOOK_TIMESTAMP_HEADER=X-Belyfted-Timestamp
WEBHOOK_TIMESTAMP_TOLERANCE_MS=300000

# ---- Logging ----
LOG_LEVEL=info

# ---- TLS / reverse proxy ----
# Set true when terminating TLS at a proxy (ngrok, nginx, ALB) in production.
TRUST_PROXY=false
